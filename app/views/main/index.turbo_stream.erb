<turbo-stream action="replace" target="articles">
  <template>
    <turbo-frame id="articles">
      <% @articles.each do |article| %>
        <div class="article">
          <h2><%= article.title %></h2>
          <p><%= article.content %></p>
        </div>
      <% end %>
    </turbo-frame>
  </template>
</turbo-stream>
